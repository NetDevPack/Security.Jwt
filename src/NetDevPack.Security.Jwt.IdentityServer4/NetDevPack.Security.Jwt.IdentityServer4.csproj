<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetDevPack.Security.Jwt.IdentityServer4</PackageId>
    <Title>[DEPRECATED] JWT Signing Credentials - IdentityServer4 Support</Title>
    <Description>
    DEPRECATED: IdentityServer4 reached end of life and has known vulnerabilities. Prefer Duende IdentityServer or OpenIddict.
    Integration package for IdentityServer4 to manage JWK/JWKS with automatic key rotation (RSA, ECDSA, HMAC).
    </Description>
    <PackageTags>deprecated;jwt;jwks;jwk;identityserver4;rsa;ecdsa;hmac;oauth2;openid;key-rotation;security;cryptography</PackageTags>
    <PackageReleaseNotes>
    v10.0.0:
    - Package is deprecated: IdentityServer4 is EOL (see GHSA-55p7-v223-x366 / GHSA-ff4q-64jc-gx98)
    - IdentityServer4 integration for JWK/JWKS management and automatic key rotation support
    </PackageReleaseNotes>
    <!-- IdentityServer4 4.1.2 is EOL and will not receive fixes. Kept only for backward compatibility. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors.Replace('NU1902', ''))</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IdentityServer4" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetDevPack.Security.Jwt.Core\NetDevPack.Security.Jwt.Core.csproj" />
  </ItemGroup>

</Project>
